{
  "name": "algoviz",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AlgoViz — an interactive sorting algorithm visualizer built with Vue 3, Vite, and Tailwind CSS.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write src/",
    "backlog:board": "node backlog/generate-board.mjs"
  },
  "dependencies": {
    "vue": "^3.4.21",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.5.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^15.15.0",
    "jsdom": "^24.1.3",
    "postcss": "^8.4.38",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.3",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.2.8",
    "vitest": "^1.5.0",
    "vue-tsc": "^2.2.12"
  }
}
