{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  // Tests are co-located (src/algorithms/*.test.ts), not in __tests__ dirs, and
  // are deliberately left included: Vitest transpiles without type-checking, so
  // vue-tsc is the only thing that ever checks them.
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "noEmit": true,

    "strict": true,
    // Deliberately OFF. Turning it on would demand `?.`/`!` on every registry
    // lookup, every `array[i]` inside the sorting generators, and every
    // Map.get() — hundreds of assertions for near-zero real safety in
    // index-loop-heavy algorithm code. Do not "fix" this.
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    // The migration is finished: src/ is entirely .ts and .vue. This is now a
    // tripwire rather than a setting — a new .js file under src/ stops
    // resolving the moment anything imports it.
    "allowJs": false,

    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "paths": { "@/*": ["./src/*"] }
  }
}
